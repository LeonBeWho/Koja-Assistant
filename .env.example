# Spotify Developer app credentials
# Create an app at https://developer.spotify.com/dashboard
# Add this Redirect URI in the app settings:
# http://127.0.0.1:8888/callback

SPOTIPY_CLIENT_ID="your_client_id_here"
SPOTIPY_CLIENT_SECRET="your_client_secret_here"
SPOTIPY_REDIRECT_URI="http://127.0.0.1:8888/callback"

# Optional display/name setting. Used in greetings, goodbyes, and transcript labels.
KOJA_USER_NAME="friend"

# Optional Piper path overrides if assets are not stored in ./piper and ./models.
# KOJA_PIPER_PATH="/path/to/piper"
# KOJA_MODEL_PATH="/path/to/en_US-hfc_male-medium.onnx"
